{
  "name": "river-route",
  "version": "0.0.0",
  "description": "river-route's Muskingum routing kernel, the C of river_route/kernels/c, compiled to WebAssembly.",
  "license": "BSD-3-Clause-Clear",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rileyhales/river-route.git",
    "directory": "wasm"
  },
  "exports": {
    "./routing.wasm": "./routing.wasm",
    "./routing-relaxed.wasm": "./routing-relaxed.wasm"
  },
  "files": [
    "routing.wasm",
    "routing-relaxed.wasm",
    "LICENSE.txt"
  ],
  "scripts": {
    "prepack": "python3 ../river_route/kernels/build.py --wasm . --checks && cp ../LICENSE.txt LICENSE.txt",
    "postpack": "rm LICENSE.txt"
  }
}
